@* Wrapped in .col so it can go straight inside a Bootstrap "row row-cols-*" grid *@
<div class="col">
    @if (OnClick.HasDelegate)
    {
        @* A real button, so it's focusable and works with Enter/Space and screen readers *@
        <button type="button" class="card h-100 w-100 text-start @(IsSelected ? "border-primary bg-primary-subtle" : "")"
                aria-pressed="@(IsSelected ? "true" : "false")" @onclick="OnClick">
            @Body
        </button>
    }
    else
    {
        <div class="card h-100">@Body</div>
    }
</div>

@code {
    [Parameter]
    public string? StatTag { get; set; }

    [Parameter]
    public string? StatTitle { get; set; }

    [Parameter]
    public IEnumerable<Stat> Stats { get; set; } = [];

    [Parameter]
    public decimal? StatBalance { get; set; }

    // Optional. The card only reports that it was clicked; the page decides what that means
    // (e.g. Accounts filters by status). Without it, the card is plain and not clickable.
    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public bool IsSelected { get; set; }

    private RenderFragment Body => @<div class="card-body w-100">
        @if (StatTag != null)
        {
            <div class="mb-2"><StatusBadge Text="@StatTag" /></div>
        }
        @if (StatTitle != null)
        {
            <div class="small text-body-secondary">@StatTitle</div>
        }

        @foreach (var stat in Stats)
        {
            <div>@stat.Value @stat.Label</div>
        }

        @if (StatBalance != null)
        {
            <div class="fs-4 fw-bold">@StatBalance.Value.ToString("C")</div>
        }
    </div>;
}
